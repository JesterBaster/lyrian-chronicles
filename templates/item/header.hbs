<header class="lyr-item-header" data-application-part="header">
  <img class="lyr-item-icon" src="{{item.img}}" data-edit="img" alt="{{item.name}}" />
  <div class="lyr-item-identity">
    <input class="lyr-name" type="text" name="name" value="{{item.name}}" placeholder="Name" />
    <span class="lyr-item-type">{{localize (concat "TYPES.Item." type)}}</span>
  </div>
</header>
