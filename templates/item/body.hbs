<section class="lyr-item-body" data-application-part="body">

{{#unless editable}}
  <div class="lyr-reference-overview">
    {{#if (eq type "ability")}}
      {{#if enrichedRequirements}}
        <section class="lyr-reference-card"><h3>{{localize "LYRIAN.UI.Requirements"}}</h3>{{{enrichedRequirements}}}</section>
      {{/if}}
      {{#if keywordChoices}}
        <section class="lyr-reference-card"><h3>{{localize "LYRIAN.UI.Keywords"}}</h3>
          <div class="lyr-summary-chips">
            {{#each keywordChoices as |kw|}}{{#if kw.active}}<span class="lyr-summary-chip">{{kw.label}}</span>{{/if}}{{/each}}
          </div>
        </section>
      {{/if}}
    {{/if}}

    {{#if (eq type "monsterAbility")}}
      {{#if enrichedRequirements}}
        <section class="lyr-reference-card"><h3>{{localize "LYRIAN.UI.Requirements"}}</h3>{{{enrichedRequirements}}}</section>
      {{/if}}
      {{#if keywordChoices}}
        <section class="lyr-reference-card"><h3>{{localize "LYRIAN.UI.Keywords"}}</h3>
          <div class="lyr-summary-chips">
            {{#each keywordChoices as |kw|}}{{#if kw.active}}<span class="lyr-summary-chip">{{kw.label}}</span>{{/if}}{{/each}}
          </div>
        </section>
      {{/if}}
    {{/if}}

    {{#if (eq type "class")}}
      {{#if enrichedRequirements}}<section class="lyr-reference-card"><h3>{{localize "LYRIAN.UI.Requirements"}}</h3>{{{enrichedRequirements}}}</section>{{/if}}
      {{#if system.skills}}<section class="lyr-reference-card"><h3>{{localize "LYRIAN.UI.Skills"}}</h3><p>{{system.skills}}</p></section>{{/if}}
      {{#if system.heart}}<section class="lyr-reference-card"><h3>{{localize "LYRIAN.UI.Heart"}}</h3><p>{{system.heart}}</p></section>{{/if}}
      {{#if system.soul}}<section class="lyr-reference-card"><h3>{{localize "LYRIAN.UI.Soul"}}</h3><p>{{system.soul}}</p></section>{{/if}}
      {{#if enrichedGuide}}<section class="lyr-reference-card lyr-reference-card--wide"><h3>{{localize "LYRIAN.UI.HowToPlay"}}</h3>{{{enrichedGuide}}}</section>{{/if}}
    {{/if}}

    {{#if (eq type "race")}}
      {{#if system.attributes}}<section class="lyr-reference-card"><h3>{{localize "LYRIAN.UI.Attributes"}}</h3><p>{{system.attributes}}</p></section>{{/if}}
      {{#if system.grantedProficiencies}}<section class="lyr-reference-card"><h3>{{localize "LYRIAN.UI.Proficiencies"}}</h3><p>{{system.grantedProficiencies}}</p></section>{{/if}}
      {{#if system.grantedSkills}}<section class="lyr-reference-card"><h3>{{localize "LYRIAN.UI.Skills"}}</h3><p>{{system.grantedSkills}}</p></section>{{/if}}
      {{#if system.ambition}}<section class="lyr-reference-card"><h3>{{localize "LYRIAN.UI.Ambition"}}</h3><p>{{system.ambition}}</p></section>{{/if}}
    {{/if}}

    {{#if (eq type "breakthrough")}}
      {{#if enrichedRequirements}}<section class="lyr-reference-card"><h3>{{localize "LYRIAN.UI.Requirements"}}</h3>{{{enrichedRequirements}}}</section>{{/if}}
    {{/if}}

    {{#if (eq type "equipment")}}
      <section class="lyr-reference-card"><h3>{{localize "LYRIAN.UI.EquipmentDetails"}}</h3>
        <dl class="lyr-facts">
          {{#if system.category}}<div><dt>{{localize "LYRIAN.UI.Category"}}</dt><dd>{{system.category}}</dd></div>{{/if}}
          {{#if system.subType}}<div><dt>{{localize "LYRIAN.UI.Type"}}</dt><dd>{{system.subType}}</dd></div>{{/if}}
          {{#if system.cost}}<div><dt>{{localize "LYRIAN.UI.Cost"}}</dt><dd>{{system.cost}}</dd></div>{{/if}}
          {{#if system.burden}}<div><dt>{{localize "LYRIAN.UI.Burden"}}</dt><dd>{{system.burden}}</dd></div>{{/if}}
          {{#if system.activationCost}}<div><dt>{{localize "LYRIAN.UI.Activation"}}</dt><dd>{{system.activationCost}}</dd></div>{{/if}}
          {{#if system.shellSize}}<div><dt>{{localize "LYRIAN.UI.ShellSize"}}</dt><dd>{{system.shellSize}}</dd></div>{{/if}}
          {{#if system.fuelUsage}}<div><dt>{{localize "LYRIAN.UI.Fuel"}}</dt><dd>{{system.fuelUsage}}</dd></div>{{/if}}
          {{#if system.craftingType}}<div><dt>{{localize "LYRIAN.UI.Crafting"}}</dt><dd>{{system.craftingPoints}} · {{system.craftingType}}</dd></div>{{/if}}
          {{#if system.unitCost}}<div><dt>{{localize "LYRIAN.UI.UnitValue"}}</dt><dd>{{system.unitCost}}</dd></div>{{/if}}
          {{#if system.targetType}}<div><dt>{{localize "LYRIAN.UI.ModTarget"}}</dt><dd>{{system.targetType}}</dd></div>{{/if}}
          {{#if system.compatibleTargets.length}}<div><dt>{{localize "LYRIAN.UI.CompatibleWith"}}</dt><dd>{{#each system.compatibleTargets}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</dd></div>{{/if}}
          {{#if system.modSlot}}<div><dt>{{localize "LYRIAN.UI.ModSlot"}}</dt><dd>{{system.modSlot}}</dd></div>{{/if}}
          {{#if system.polarityType}}<div><dt>{{localize "LYRIAN.UI.Polarity"}}</dt><dd>{{system.polarityType}}{{#if system.polarityUnits}} · {{system.polarityUnits}} {{localize "LYRIAN.UI.Units"}}{{/if}}</dd></div>{{/if}}
          {{#if system.rarity}}<div><dt>{{localize "LYRIAN.UI.Rarity"}}</dt><dd>{{system.rarity}}</dd></div>{{/if}}
          {{#if system.multiplier}}<div><dt>{{localize "LYRIAN.UI.MaterialMultiplier"}}</dt><dd>{{system.multiplier}}</dd></div>{{/if}}
          {{#if system.growingTime}}<div><dt>{{localize "LYRIAN.UI.GrowingTime"}}</dt><dd>{{system.growingTime}}</dd></div>{{/if}}
          {{#if system.difficulty}}<div><dt>{{localize "LYRIAN.UI.Difficulty"}}</dt><dd>{{system.difficulty}}</dd></div>{{/if}}
        </dl>
      </section>
    {{/if}}

    {{#if enrichedRelationships}}
      <section class="lyr-reference-card lyr-reference-card--wide"><h3>{{localize "LYRIAN.UI.RelatedEntries"}}</h3>{{{enrichedRelationships}}}</section>
    {{/if}}
  </div>
{{/unless}}

{{#if editable}}

{{#if (eq type "weapon")}}
  <div class="lyr-field-grid">
    <label>{{localize "LYRIAN.UI.WeaponGroup"}}
      <select name="system.group">
        {{#each config.weaponGroups as |group key|}}
          <option value="{{key}}" {{#if (eq ../system.group key)}}selected{{/if}}>{{localize group.label}}</option>
        {{/each}}
      </select>
    </label>
    <label>{{localize "LYRIAN.UI.Hands"}}
      <select name="system.hands">
        {{#each config.weaponHands as |label key|}}
          <option value="{{key}}" {{#if (eq ../system.hands key)}}selected{{/if}}>{{localize label}}</option>
        {{/each}}
      </select>
    </label>
    <label>{{localize "LYRIAN.UI.DamageType"}}
      <select name="system.damageType">
        {{#each config.damageTypes as |dt key|}}
          <option value="{{key}}" {{#if (eq ../system.damageType key)}}selected{{/if}}>{{localize dt.label}}</option>
        {{/each}}
      </select>
    </label>
    <label>{{localize "LYRIAN.UI.AccuracyBonus"}} <input type="number" name="system.accuracyBonus" value="{{system.accuracyBonus}}" /></label>
    <label>{{localize "LYRIAN.UI.DamageBonus"}} <input type="number" name="system.damageBonus" value="{{system.damageBonus}}" /></label>
    <label>{{localize "LYRIAN.UI.CritOn"}} <input type="number" name="system.critThreshold" value="{{system.critThreshold}}" min="2" max="20" /></label>
    <label>{{localize "LYRIAN.UI.RangeOverride"}} <input type="number" name="system.rangeOverride" value="{{system.rangeOverride}}" /></label>
    <label>{{localize "LYRIAN.UI.Burden"}} <input type="number" name="system.burden" value="{{system.burden}}" /></label>
    <label>{{localize "LYRIAN.UI.ValueClim"}} <input type="number" name="system.value" value="{{system.value}}" /></label>
    <label class="lyr-check"><input type="checkbox" name="system.equipped" {{checked system.equipped}} /> {{localize "LYRIAN.UI.Equipped"}}</label>
    <label class="lyr-check"><input type="checkbox" name="system.proficient" {{checked system.proficient}} /> {{localize "LYRIAN.UI.Proficient"}}</label>
    <label class="lyr-check"><input type="checkbox" name="system.offHand" {{checked system.offHand}} /> {{localize "LYRIAN.UI.OffHand"}}</label>
  </div>
  <p class="lyr-note">
    {{localize "LYRIAN.UI.GroupProperty"}}: <strong>{{localize system.propertyLabel}}</strong>.
    {{localize "LYRIAN.Hint.WeaponEffective" range=system.range crit=system.effectiveCrit}}
  </p>
  <label>{{localize "LYRIAN.UI.Enchantment"}} <input type="text" name="system.enchantment" value="{{system.enchantment}}" /></label>
  <div class="lyr-field-grid">
    <label>{{localize "LYRIAN.UI.AppliedPoison"}} <input type="text" name="system.poison.name" value="{{system.poison.name}}" /></label>
    <label>{{localize "LYRIAN.UI.HitsRemaining"}} <input type="number" name="system.poison.hitsRemaining" value="{{system.poison.hitsRemaining}}" /></label>
  </div>
{{/if}}

{{#if (eq type "armor")}}
  <div class="lyr-field-grid">
    <label>{{localize "LYRIAN.UI.Category"}}
      <select name="system.category">
        {{#each config.armorCategories as |cat key|}}
          <option value="{{key}}" {{#if (eq ../system.category key)}}selected{{/if}}>{{localize cat.label}}</option>
        {{/each}}
      </select>
    </label>
    <label>{{localize "LYRIAN.UI.ExtraGuard"}} <input type="number" name="system.guardBonus" value="{{system.guardBonus}}" /></label>
    <label>{{localize "LYRIAN.UI.ExtraBlock"}} <input type="number" name="system.blockBonus" value="{{system.blockBonus}}" /></label>
    <label>{{localize "LYRIAN.UI.Burden"}} <input type="number" name="system.burden" value="{{system.burden}}" /></label>
    <label>{{localize "LYRIAN.UI.ValueClim"}} <input type="number" name="system.value" value="{{system.value}}" /></label>
    <label class="lyr-check"><input type="checkbox" name="system.equipped" {{checked system.equipped}} /> {{localize "LYRIAN.UI.Equipped"}}</label>
    <label class="lyr-check"><input type="checkbox" name="system.proficient" {{checked system.proficient}} /> {{localize "LYRIAN.UI.Proficient"}}</label>
  </div>
  <label>{{localize "LYRIAN.UI.Modification"}} <input type="text" name="system.modification" value="{{system.modification}}" /></label>
  <p class="lyr-note">
    {{localize "LYRIAN.Hint.ArmourValues" guard=(lyrianSigned system.guard) block=system.blockValue evasion=(lyrianSigned system.evasionPenalty) initiative=(lyrianSigned system.initiativePenalty)}}
  </p>
{{/if}}

{{#if (eq type "ability")}}
  <div class="lyr-field-grid">
    <label>{{localize "LYRIAN.UI.APCost"}} <input type="number" name="system.apCost" value="{{system.apCost}}" /></label>
    <label>{{localize "LYRIAN.UI.RPCost"}} <input type="number" name="system.rpCost" value="{{system.rpCost}}" /></label>
    <label>{{localize "LYRIAN.UI.ManaCost"}} <input type="number" name="system.manaCost" value="{{system.manaCost}}" /></label>
    <label>{{localize "LYRIAN.UI.UpkeepAP"}} <input type="number" name="system.upkeep" value="{{system.upkeep}}" /></label>
    <label>{{localize "LYRIAN.UI.Timing"}}
      <select name="system.timing">
        {{#each config.abilityTiming as |label key|}}
          <option value="{{key}}" {{#if (eq ../system.timing key)}}selected{{/if}}>{{localize label}}</option>
        {{/each}}
      </select>
    </label>
    <label>{{localize "LYRIAN.UI.Range"}} <input type="text" name="system.range" value="{{system.range}}" placeholder="{{localize "LYRIAN.Placeholder.Range"}}" /></label>
    <label>{{localize "LYRIAN.UI.OtherCosts"}} <input type="text" name="system.otherCosts" value="{{system.otherCosts}}" /></label>
    <label>{{localize "LYRIAN.UI.Requirement"}} <input type="text" name="system.requirement" value="{{system.requirement}}" /></label>
    <label>{{localize "LYRIAN.UI.FromClass"}} <input type="text" name="system.classSource" value="{{system.classSource}}" /></label>
  </div>

  <fieldset class="lyr-keywords">
    <legend>{{localize "LYRIAN.UI.Keywords"}}</legend>
    {{#each keywordChoices as |kw|}}
      <button type="button" class="lyr-keyword {{#if kw.active}}lyr-keyword--on{{/if}} {{#unless kw.automated}}lyr-keyword--manual{{/unless}}"
              data-action="toggleKeyword" data-keyword="{{kw.key}}"
              title="{{#if kw.automated}}{{localize "LYRIAN.Hint.AutomatedKeyword"}}{{else}}{{localize "LYRIAN.Hint.ManualKeyword"}}{{/if}}">{{kw.label}}</button>
    {{/each}}
  </fieldset>

  <fieldset class="lyr-attack-block">
    <legend>{{localize "LYRIAN.UI.Attack"}}</legend>
    <label class="lyr-check"><input type="checkbox" name="system.hasAttack" {{checked system.hasAttack}} /> {{localize "LYRIAN.UI.AbilityMakesAttack"}}</label>
    <div class="lyr-field-grid">
      <label>{{localize "LYRIAN.UI.AttackType"}}
        <select name="system.attackType">
          {{#each config.attackTypes as |at key|}}
            <option value="{{key}}" {{#if (eq ../system.attackType key)}}selected{{/if}}>{{localize at.label}}</option>
          {{/each}}
        </select>
      </label>
      <label>{{localize "LYRIAN.UI.DamageFormula"}} <input type="text" name="system.damageFormula" value="{{system.damageFormula}}" placeholder="{{localize "LYRIAN.Placeholder.DamageFormula"}}" /></label>
      <label>{{localize "LYRIAN.UI.DamageType"}}
        <select name="system.damageType">
          {{#each config.damageTypes as |dt key|}}
            <option value="{{key}}" {{#if (eq ../system.damageType key)}}selected{{/if}}>{{localize dt.label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="lyr-check"><input type="checkbox" name="system.usesWeapon" {{checked system.usesWeapon}} /> {{localize "LYRIAN.UI.UseWeaponDamage"}}</label>
    </div>
  </fieldset>
{{/if}}

{{#if (eq type "keyword")}}
  <label>{{localize "LYRIAN.UI.Keyword"}} <input type="text" name="system.keyword" value="{{system.keyword}}" /></label>
{{/if}}

{{#if (eq type "monsterAbility")}}
  <div class="lyr-field-grid">
    <label>{{localize "LYRIAN.UI.Kind"}}
      <select name="system.kind">
        <option value="passive" {{#if (eq system.kind "passive")}}selected{{/if}}>{{localize "LYRIAN.Timing.Passive"}}</option>
        <option value="active-action" {{#if (eq system.kind "active-action")}}selected{{/if}}>{{localize "LYRIAN.Timing.Action"}}</option>
      </select>
    </label>
    <label>{{localize "LYRIAN.UI.APCost"}} <input type="number" name="system.apCost" value="{{system.apCost}}" /></label>
    <label>{{localize "LYRIAN.UI.RPCost"}} <input type="number" name="system.rpCost" value="{{system.rpCost}}" /></label>
    <label>{{localize "LYRIAN.UI.ManaCost"}} <input type="number" name="system.manaCost" value="{{system.manaCost}}" /></label>
    <label>{{localize "LYRIAN.UI.Range"}} <input type="text" name="system.range" value="{{system.range}}" /></label>
    <label>{{localize "LYRIAN.UI.Requirement"}} <input type="text" name="system.requirement" value="{{system.requirement}}" /></label>
  </div>
{{/if}}

{{#if (eq type "class")}}
  <div class="lyr-field-grid">
    <label>{{localize "LYRIAN.UI.Tier"}} <input type="number" name="system.tier" value="{{system.tier}}" min="1" max="5" /></label>
    <label>{{localize "LYRIAN.UI.ClassLevel"}} <input type="number" name="system.abilitiesUnlocked" value="{{system.abilitiesUnlocked}}" min="1" max="8" /></label>
    <label class="lyr-check"><input type="checkbox" name="system.artisan" {{checked system.artisan}} /> {{localize "LYRIAN.UI.ArtisanClass"}}</label>
    <label class="lyr-check"><input type="checkbox" name="system.gathering" {{checked system.gathering}} /> {{localize "LYRIAN.UI.GatheringClass"}}</label>
  </div>
  <label>{{localize "LYRIAN.UI.KeyAbilities"}} <input type="text" name="system.keyAbilities" value="{{system.keyAbilities}}" /></label>
  <label>{{localize "LYRIAN.UI.Requirements"}} <input type="text" name="system.requirements" value="{{system.requirements}}" /></label>
  <p class="lyr-note">{{localize "LYRIAN.Hint.ClassInvestment" cost=system.unlockCost invested=system.expInvested}}</p>
{{/if}}

{{#if (eq type "breakthrough")}}
  <div class="lyr-field-grid">
    <label>{{localize "LYRIAN.UI.ExpCost"}} <input type="number" name="system.expCost" value="{{system.expCost}}" /></label>
    <label>{{localize "LYRIAN.UI.Level"}} <input type="number" name="system.level" value="{{system.level}}" min="1" /></label>
    <label class="lyr-check"><input type="checkbox" name="system.repeatable" {{checked system.repeatable}} /> {{localize "LYRIAN.UI.Repeatable"}}</label>
  </div>
  <label>{{localize "LYRIAN.UI.Requirements"}} <input type="text" name="system.requirements" value="{{system.requirements}}" /></label>
{{/if}}

{{#if (eq type "race")}}
  <div class="lyr-field-grid">
    <label>{{localize "LYRIAN.Race.Subrace"}} <input type="text" name="system.subrace" value="{{system.subrace}}" /></label>
    <label>{{localize "LYRIAN.UI.Clan"}} <input type="text" name="system.clan" value="{{system.clan}}" /></label>
    <label>{{localize "LYRIAN.UI.Size"}}
      <select name="system.size">
        {{#each config.creatureSizes as |sz key|}}
          <option value="{{key}}" {{#if (eq ../system.size key)}}selected{{/if}}>{{localize sz.label}}</option>
        {{/each}}
      </select>
    </label>
    <label>{{localize "LYRIAN.Defence.Speed"}} <input type="number" name="system.speed" value="{{system.speed}}" /></label>
    {{#if system.attributeBonuses.chooseMain}}
      <label>{{localize "LYRIAN.UI.MainStatChoice"}}
        <select name="system.selectedMainStat"><option value="">—</option>{{#each config.mainStats as |label key|}}<option value="{{key}}" {{#if (eq ../system.selectedMainStat key)}}selected{{/if}}>{{localize label}}</option>{{/each}}</select>
      </label>
    {{/if}}
    {{#if system.attributeBonuses.chooseSub}}
      <label>{{localize "LYRIAN.UI.SubStatChoice"}}
        <select name="system.selectedSubStat"><option value="">—</option>{{#each config.subStats as |label key|}}<option value="{{key}}" {{#if (eq ../system.selectedSubStat key)}}selected{{/if}}>{{localize label}}</option>{{/each}}</select>
      </label>
    {{/if}}
    {{#if system.variants.length}}
      <label>{{localize "LYRIAN.Creation.DemonHouse"}}
        <select name="system.selectedVariant"><option value="">—</option>{{#each system.variants as |choice|}}<option value="{{choice.key}}" {{#if (eq ../system.selectedVariant choice.key)}}selected{{/if}}>{{choice.name}}</option>{{/each}}</select>
      </label>
    {{/if}}
  </div>
  <label>{{localize "LYRIAN.UI.GrantedProficiencies"}} <input type="text" name="system.grantedProficiencies" value="{{system.grantedProficiencies}}" /></label>
  <label>{{localize "LYRIAN.UI.GrantedSkills"}} <input type="text" name="system.grantedSkills" value="{{system.grantedSkills}}" /></label>
  {{#if raceSkillChoices.length}}
    <fieldset class="lyr-keywords">
      <legend>{{localize "LYRIAN.UI.RacialSkillAllocation" points=raceSkillGrant.points}}</legend>
      <div class="lyr-field-grid">
        {{#each raceSkillChoices as |skill|}}
          <label>{{skill.label}} <input type="number" name="system.selectedSkillBonuses.{{skill.key}}" value="{{skill.value}}" min="0" max="{{../raceSkillGrant.points}}" /></label>
        {{/each}}
      </div>
    </fieldset>
  {{/if}}
{{/if}}

{{#if (eq type "equipment")}}
  <div class="lyr-field-grid">
    <label>{{localize "LYRIAN.UI.Category"}} <input type="text" name="system.category" value="{{system.category}}" /></label>
    <label>{{localize "LYRIAN.UI.Type"}} <input type="text" name="system.subType" value="{{system.subType}}" /></label>
    <label>{{localize "LYRIAN.UI.Cost"}} <input type="text" name="system.cost" value="{{system.cost}}" /></label>
    <label>{{localize "LYRIAN.UI.Burden"}} <input type="text" name="system.burden" value="{{system.burden}}" /></label>
    <label>{{localize "LYRIAN.UI.Activation"}} <input type="text" name="system.activationCost" value="{{system.activationCost}}" /></label>
    <label>{{localize "LYRIAN.UI.UnitValue"}} <input type="text" name="system.unitCost" value="{{system.unitCost}}" /></label>
    <label>{{localize "LYRIAN.UI.CraftingType"}} <input type="text" name="system.craftingType" value="{{system.craftingType}}" /></label>
    <label>{{localize "LYRIAN.UI.CraftingPoints"}} <input type="number" name="system.craftingPoints" value="{{system.craftingPoints}}" /></label>
    <label>{{localize "LYRIAN.UI.ModTarget"}} <input type="text" name="system.targetType" value="{{system.targetType}}" /></label>
    <label>{{localize "LYRIAN.UI.ModSlot"}} <input type="text" name="system.modSlot" value="{{system.modSlot}}" /></label>
    <label>{{localize "LYRIAN.UI.PolarityType"}} <input type="text" name="system.polarityType" value="{{system.polarityType}}" /></label>
    <label>{{localize "LYRIAN.UI.PolarityUnits"}} <input type="number" name="system.polarityUnits" value="{{system.polarityUnits}}" /></label>
    <label>{{localize "LYRIAN.UI.Quantity"}} <input type="number" name="system.quantity" value="{{system.quantity}}" /></label>
  </div>
{{/if}}

{{#if (eq type "gear")}}
  <div class="lyr-field-grid">
    <label>{{localize "LYRIAN.UI.Quantity"}} <input type="number" name="system.quantity" value="{{system.quantity}}" /></label>
    <label>{{localize "LYRIAN.UI.BurdenEach"}} <input type="number" name="system.burden" value="{{system.burden}}" /></label>
    <label>{{localize "LYRIAN.UI.ValueClim"}} <input type="number" name="system.value" value="{{system.value}}" /></label>
    <label>{{localize "LYRIAN.UI.MaterialType"}} <input type="text" name="system.materialType" value="{{system.materialType}}" placeholder="{{localize "LYRIAN.Placeholder.MaterialType"}}" /></label>
    <label>{{localize "LYRIAN.UI.Units"}} <input type="number" name="system.units" value="{{system.units}}" /></label>
    <label class="lyr-check"><input type="checkbox" name="system.combatItem" {{checked system.combatItem}} /> {{localize "LYRIAN.UI.CombatItem"}}</label>
    <label class="lyr-check"><input type="checkbox" name="system.isKit" {{checked system.isKit}} /> {{localize "LYRIAN.UI.Kit"}}</label>
  </div>
{{/if}}

{{#if (eq type "injury")}}
  <div class="lyr-field-grid">
    <label>{{localize "LYRIAN.UI.Rolled"}} <input type="number" name="system.rolled" value="{{system.rolled}}" min="0" max="10" /></label>
    <label class="lyr-check"><input type="checkbox" name="system.fromDowned" {{checked system.fromDowned}} /> {{localize "LYRIAN.UI.FromDowned"}}</label>
    <label class="lyr-check"><input type="checkbox" name="system.suppressed" {{checked system.suppressed}} /> {{localize "LYRIAN.UI.Suppressed"}}</label>
  </div>
  <p class="lyr-note">{{localize "LYRIAN.Hint.InjuryRecovery"}}</p>
{{/if}}

<label>{{localize "LYRIAN.UI.Source"}} <input type="text" name="system.source" value="{{system.source}}" placeholder="{{localize "LYRIAN.Placeholder.Source"}}" /></label>
{{/if}}
</section>
