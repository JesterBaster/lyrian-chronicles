<section class="lyr-item-body" data-application-part="body">

{{#unless editable}}
  <div class="lyr-reference-overview">
    {{#if (eq type "ability")}}
      {{#if enrichedRequirements}}
        <section class="lyr-reference-card"><h3>Requirements</h3>{{{enrichedRequirements}}}</section>
      {{/if}}
      {{#if keywordChoices}}
        <section class="lyr-reference-card"><h3>Keywords</h3>
          <div class="lyr-summary-chips">
            {{#each keywordChoices as |kw|}}{{#if kw.active}}<span class="lyr-summary-chip">{{kw.label}}</span>{{/if}}{{/each}}
          </div>
        </section>
      {{/if}}
    {{/if}}

    {{#if (eq type "monsterAbility")}}
      {{#if enrichedRequirements}}
        <section class="lyr-reference-card"><h3>Requirements</h3>{{{enrichedRequirements}}}</section>
      {{/if}}
      {{#if keywordChoices}}
        <section class="lyr-reference-card"><h3>Keywords</h3>
          <div class="lyr-summary-chips">
            {{#each keywordChoices as |kw|}}{{#if kw.active}}<span class="lyr-summary-chip">{{kw.label}}</span>{{/if}}{{/each}}
          </div>
        </section>
      {{/if}}
    {{/if}}

    {{#if (eq type "class")}}
      {{#if enrichedRequirements}}<section class="lyr-reference-card"><h3>Requirements</h3>{{{enrichedRequirements}}}</section>{{/if}}
      {{#if system.skills}}<section class="lyr-reference-card"><h3>Skills</h3><p>{{system.skills}}</p></section>{{/if}}
      {{#if system.heart}}<section class="lyr-reference-card"><h3>Heart</h3><p>{{system.heart}}</p></section>{{/if}}
      {{#if system.soul}}<section class="lyr-reference-card"><h3>Soul</h3><p>{{system.soul}}</p></section>{{/if}}
      {{#if enrichedGuide}}<section class="lyr-reference-card lyr-reference-card--wide"><h3>How to play</h3>{{{enrichedGuide}}}</section>{{/if}}
    {{/if}}

    {{#if (eq type "race")}}
      {{#if system.attributes}}<section class="lyr-reference-card"><h3>Attributes</h3><p>{{system.attributes}}</p></section>{{/if}}
      {{#if system.grantedProficiencies}}<section class="lyr-reference-card"><h3>Proficiencies</h3><p>{{system.grantedProficiencies}}</p></section>{{/if}}
      {{#if system.grantedSkills}}<section class="lyr-reference-card"><h3>Skills</h3><p>{{system.grantedSkills}}</p></section>{{/if}}
      {{#if system.ambition}}<section class="lyr-reference-card"><h3>Ambition</h3><p>{{system.ambition}}</p></section>{{/if}}
    {{/if}}

    {{#if (eq type "breakthrough")}}
      {{#if enrichedRequirements}}<section class="lyr-reference-card"><h3>Requirements</h3>{{{enrichedRequirements}}}</section>{{/if}}
    {{/if}}

    {{#if (eq type "equipment")}}
      <section class="lyr-reference-card"><h3>Equipment details</h3>
        <dl class="lyr-facts">
          {{#if system.category}}<div><dt>Category</dt><dd>{{system.category}}</dd></div>{{/if}}
          {{#if system.subType}}<div><dt>Type</dt><dd>{{system.subType}}</dd></div>{{/if}}
          {{#if system.cost}}<div><dt>Cost</dt><dd>{{system.cost}}</dd></div>{{/if}}
          {{#if system.burden}}<div><dt>Burden</dt><dd>{{system.burden}}</dd></div>{{/if}}
          {{#if system.activationCost}}<div><dt>Activation</dt><dd>{{system.activationCost}}</dd></div>{{/if}}
          {{#if system.shellSize}}<div><dt>Shell size</dt><dd>{{system.shellSize}}</dd></div>{{/if}}
          {{#if system.fuelUsage}}<div><dt>Fuel</dt><dd>{{system.fuelUsage}}</dd></div>{{/if}}
          {{#if system.craftingType}}<div><dt>Crafting</dt><dd>{{system.craftingPoints}} · {{system.craftingType}}</dd></div>{{/if}}
          {{#if system.unitCost}}<div><dt>Unit value</dt><dd>{{system.unitCost}}</dd></div>{{/if}}
          {{#if system.targetType}}<div><dt>Mod target</dt><dd>{{system.targetType}}</dd></div>{{/if}}
          {{#if system.compatibleTargets.length}}<div><dt>Compatible with</dt><dd>{{#each system.compatibleTargets}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</dd></div>{{/if}}
          {{#if system.modSlot}}<div><dt>Mod slot</dt><dd>{{system.modSlot}}</dd></div>{{/if}}
          {{#if system.polarityType}}<div><dt>Polarity</dt><dd>{{system.polarityType}}{{#if system.polarityUnits}} · {{system.polarityUnits}} units{{/if}}</dd></div>{{/if}}
          {{#if system.rarity}}<div><dt>Rarity</dt><dd>{{system.rarity}}</dd></div>{{/if}}
          {{#if system.multiplier}}<div><dt>Material multiplier</dt><dd>{{system.multiplier}}</dd></div>{{/if}}
          {{#if system.growingTime}}<div><dt>Growing time</dt><dd>{{system.growingTime}}</dd></div>{{/if}}
          {{#if system.difficulty}}<div><dt>Difficulty</dt><dd>{{system.difficulty}}</dd></div>{{/if}}
        </dl>
      </section>
    {{/if}}

    {{#if enrichedRelationships}}
      <section class="lyr-reference-card lyr-reference-card--wide"><h3>Related entries</h3>{{{enrichedRelationships}}}</section>
    {{/if}}
  </div>
{{/unless}}

{{#if editable}}

{{#if (eq type "weapon")}}
  <div class="lyr-field-grid">
    <label>Weapon group
      <select name="system.group">
        {{#each config.weaponGroups as |group key|}}
          <option value="{{key}}" {{#if (eq ../system.group key)}}selected{{/if}}>{{localize group.label}}</option>
        {{/each}}
      </select>
    </label>
    <label>Hands
      <select name="system.hands">
        {{#each config.weaponHands as |label key|}}
          <option value="{{key}}" {{#if (eq ../system.hands key)}}selected{{/if}}>{{localize label}}</option>
        {{/each}}
      </select>
    </label>
    <label>Damage type
      <select name="system.damageType">
        {{#each config.damageTypes as |dt key|}}
          <option value="{{key}}" {{#if (eq ../system.damageType key)}}selected{{/if}}>{{localize dt.label}}</option>
        {{/each}}
      </select>
    </label>
    <label>Accuracy bonus <input type="number" name="system.accuracyBonus" value="{{system.accuracyBonus}}" /></label>
    <label>Damage bonus <input type="number" name="system.damageBonus" value="{{system.damageBonus}}" /></label>
    <label>Crit on <input type="number" name="system.critThreshold" value="{{system.critThreshold}}" min="2" max="20" /></label>
    <label>Range override (ft) <input type="number" name="system.rangeOverride" value="{{system.rangeOverride}}" /></label>
    <label>Burden <input type="number" name="system.burden" value="{{system.burden}}" /></label>
    <label>Value (Clim) <input type="number" name="system.value" value="{{system.value}}" /></label>
    <label class="lyr-check"><input type="checkbox" name="system.equipped" {{checked system.equipped}} /> Equipped</label>
    <label class="lyr-check"><input type="checkbox" name="system.proficient" {{checked system.proficient}} /> Proficient</label>
    <label class="lyr-check"><input type="checkbox" name="system.offHand" {{checked system.offHand}} /> Off hand</label>
  </div>
  <p class="lyr-note">
    Group property: <strong>{{localize system.propertyLabel}}</strong>.
    Effective range {{system.range}} ft. Crits on {{system.effectiveCrit}}+.
  </p>
  <label>Enchantment <input type="text" name="system.enchantment" value="{{system.enchantment}}" /></label>
  <div class="lyr-field-grid">
    <label>Applied poison <input type="text" name="system.poison.name" value="{{system.poison.name}}" /></label>
    <label>Hits remaining <input type="number" name="system.poison.hitsRemaining" value="{{system.poison.hitsRemaining}}" /></label>
  </div>
{{/if}}

{{#if (eq type "armor")}}
  <div class="lyr-field-grid">
    <label>Category
      <select name="system.category">
        {{#each config.armorCategories as |cat key|}}
          <option value="{{key}}" {{#if (eq ../system.category key)}}selected{{/if}}>{{localize cat.label}}</option>
        {{/each}}
      </select>
    </label>
    <label>Extra guard <input type="number" name="system.guardBonus" value="{{system.guardBonus}}" /></label>
    <label>Extra block <input type="number" name="system.blockBonus" value="{{system.blockBonus}}" /></label>
    <label>Burden <input type="number" name="system.burden" value="{{system.burden}}" /></label>
    <label>Value (Clim) <input type="number" name="system.value" value="{{system.value}}" /></label>
    <label class="lyr-check"><input type="checkbox" name="system.equipped" {{checked system.equipped}} /> Equipped</label>
    <label class="lyr-check"><input type="checkbox" name="system.proficient" {{checked system.proficient}} /> Proficient</label>
  </div>
  <label>Modification <input type="text" name="system.modification" value="{{system.modification}}" /></label>
  <p class="lyr-note">
    Guard {{lyrianSigned system.guard}} · Block value {{system.blockValue}} ·
    Evasion {{lyrianSigned system.evasionPenalty}} · Initiative {{lyrianSigned system.initiativePenalty}}
  </p>
{{/if}}

{{#if (eq type "ability")}}
  <div class="lyr-field-grid">
    <label>AP cost <input type="number" name="system.apCost" value="{{system.apCost}}" /></label>
    <label>RP cost <input type="number" name="system.rpCost" value="{{system.rpCost}}" /></label>
    <label>Mana cost <input type="number" name="system.manaCost" value="{{system.manaCost}}" /></label>
    <label>Upkeep (AP) <input type="number" name="system.upkeep" value="{{system.upkeep}}" /></label>
    <label>Timing
      <select name="system.timing">
        {{#each config.abilityTiming as |label key|}}
          <option value="{{key}}" {{#if (eq ../system.timing key)}}selected{{/if}}>{{localize label}}</option>
        {{/each}}
      </select>
    </label>
    <label>Range <input type="text" name="system.range" value="{{system.range}}" placeholder="60 ft, self, 15 ft radius" /></label>
    <label>Other costs <input type="text" name="system.otherCosts" value="{{system.otherCosts}}" /></label>
    <label>Requirement <input type="text" name="system.requirement" value="{{system.requirement}}" /></label>
    <label>From class <input type="text" name="system.classSource" value="{{system.classSource}}" /></label>
  </div>

  <fieldset class="lyr-keywords">
    <legend>Keywords</legend>
    {{#each keywordChoices as |kw|}}
      <button type="button" class="lyr-keyword {{#if kw.active}}lyr-keyword--on{{/if}} {{#unless kw.automated}}lyr-keyword--manual{{/unless}}"
              data-action="toggleKeyword" data-keyword="{{kw.key}}"
              title="{{#if kw.automated}}Automated by the system{{else}}Display only — resolve at the table{{/if}}">{{kw.label}}</button>
    {{/each}}
  </fieldset>

  <fieldset class="lyr-attack-block">
    <legend>Attack</legend>
    <label class="lyr-check"><input type="checkbox" name="system.hasAttack" {{checked system.hasAttack}} /> This ability makes an attack</label>
    <div class="lyr-field-grid">
      <label>Attack type
        <select name="system.attackType">
          {{#each config.attackTypes as |at key|}}
            <option value="{{key}}" {{#if (eq ../system.attackType key)}}selected{{/if}}>{{localize at.label}}</option>
          {{/each}}
        </select>
      </label>
      <label>Damage formula <input type="text" name="system.damageFormula" value="{{system.damageFormula}}" placeholder="2d6 + @power" /></label>
      <label>Damage type
        <select name="system.damageType">
          {{#each config.damageTypes as |dt key|}}
            <option value="{{key}}" {{#if (eq ../system.damageType key)}}selected{{/if}}>{{localize dt.label}}</option>
          {{/each}}
        </select>
      </label>
      <label class="lyr-check"><input type="checkbox" name="system.usesWeapon" {{checked system.usesWeapon}} /> Use equipped weapon damage</label>
    </div>
  </fieldset>
{{/if}}

{{#if (eq type "keyword")}}
  <label>Keyword <input type="text" name="system.keyword" value="{{system.keyword}}" /></label>
{{/if}}

{{#if (eq type "monsterAbility")}}
  <div class="lyr-field-grid">
    <label>Kind
      <select name="system.kind">
        <option value="passive" {{#if (eq system.kind "passive")}}selected{{/if}}>Passive</option>
        <option value="active-action" {{#if (eq system.kind "active-action")}}selected{{/if}}>Active action</option>
      </select>
    </label>
    <label>AP cost <input type="number" name="system.apCost" value="{{system.apCost}}" /></label>
    <label>RP cost <input type="number" name="system.rpCost" value="{{system.rpCost}}" /></label>
    <label>Mana cost <input type="number" name="system.manaCost" value="{{system.manaCost}}" /></label>
    <label>Range <input type="text" name="system.range" value="{{system.range}}" /></label>
    <label>Requirement <input type="text" name="system.requirement" value="{{system.requirement}}" /></label>
  </div>
{{/if}}

{{#if (eq type "class")}}
  <div class="lyr-field-grid">
    <label>Tier <input type="number" name="system.tier" value="{{system.tier}}" min="1" max="5" /></label>
    <label>Class level <input type="number" name="system.abilitiesUnlocked" value="{{system.abilitiesUnlocked}}" min="1" max="8" /></label>
    <label class="lyr-check"><input type="checkbox" name="system.artisan" {{checked system.artisan}} /> Artisan class</label>
    <label class="lyr-check"><input type="checkbox" name="system.gathering" {{checked system.gathering}} /> Gathering class</label>
  </div>
  <label>Key abilities <input type="text" name="system.keyAbilities" value="{{system.keyAbilities}}" /></label>
  <label>Requirements <input type="text" name="system.requirements" value="{{system.requirements}}" /></label>
  <p class="lyr-note">Unlock cost {{system.unlockCost}} EXP plus 1 interlude point. Total invested {{system.expInvested}} EXP.</p>
{{/if}}

{{#if (eq type "breakthrough")}}
  <div class="lyr-field-grid">
    <label>EXP cost <input type="number" name="system.expCost" value="{{system.expCost}}" /></label>
    <label>Level <input type="number" name="system.level" value="{{system.level}}" min="1" /></label>
    <label class="lyr-check"><input type="checkbox" name="system.repeatable" {{checked system.repeatable}} /> Repeatable</label>
  </div>
  <label>Requirements <input type="text" name="system.requirements" value="{{system.requirements}}" /></label>
{{/if}}

{{#if (eq type "race")}}
  <div class="lyr-field-grid">
    <label>Subrace <input type="text" name="system.subrace" value="{{system.subrace}}" /></label>
    <label>Clan <input type="text" name="system.clan" value="{{system.clan}}" /></label>
    <label>Size
      <select name="system.size">
        {{#each config.creatureSizes as |sz key|}}
          <option value="{{key}}" {{#if (eq ../system.size key)}}selected{{/if}}>{{localize sz.label}}</option>
        {{/each}}
      </select>
    </label>
    <label>Speed <input type="number" name="system.speed" value="{{system.speed}}" /></label>
    {{#if system.attributeBonuses.chooseMain}}
      <label>Main stat choice
        <select name="system.selectedMainStat"><option value="">—</option>{{#each config.mainStats as |label key|}}<option value="{{key}}" {{#if (eq ../system.selectedMainStat key)}}selected{{/if}}>{{localize label}}</option>{{/each}}</select>
      </label>
    {{/if}}
    {{#if system.attributeBonuses.chooseSub}}
      <label>Sub stat choice
        <select name="system.selectedSubStat"><option value="">—</option>{{#each config.subStats as |label key|}}<option value="{{key}}" {{#if (eq ../system.selectedSubStat key)}}selected{{/if}}>{{localize label}}</option>{{/each}}</select>
      </label>
    {{/if}}
    {{#if system.variants.length}}
      <label>Demon house
        <select name="system.selectedVariant"><option value="">—</option>{{#each system.variants as |choice|}}<option value="{{choice.key}}" {{#if (eq ../system.selectedVariant choice.key)}}selected{{/if}}>{{choice.name}}</option>{{/each}}</select>
      </label>
    {{/if}}
  </div>
  <label>Granted proficiencies <input type="text" name="system.grantedProficiencies" value="{{system.grantedProficiencies}}" /></label>
  <label>Granted skills <input type="text" name="system.grantedSkills" value="{{system.grantedSkills}}" /></label>
  {{#if raceSkillChoices.length}}
    <fieldset class="lyr-keywords">
      <legend>Racial skill allocation — up to {{raceSkillGrant.points}} points</legend>
      <div class="lyr-field-grid">
        {{#each raceSkillChoices as |skill|}}
          <label>{{skill.label}} <input type="number" name="system.selectedSkillBonuses.{{skill.key}}" value="{{skill.value}}" min="0" max="{{../raceSkillGrant.points}}" /></label>
        {{/each}}
      </div>
    </fieldset>
  {{/if}}
{{/if}}

{{#if (eq type "equipment")}}
  <div class="lyr-field-grid">
    <label>Category <input type="text" name="system.category" value="{{system.category}}" /></label>
    <label>Type <input type="text" name="system.subType" value="{{system.subType}}" /></label>
    <label>Cost <input type="text" name="system.cost" value="{{system.cost}}" /></label>
    <label>Burden <input type="text" name="system.burden" value="{{system.burden}}" /></label>
    <label>Activation <input type="text" name="system.activationCost" value="{{system.activationCost}}" /></label>
    <label>Unit value <input type="text" name="system.unitCost" value="{{system.unitCost}}" /></label>
    <label>Crafting type <input type="text" name="system.craftingType" value="{{system.craftingType}}" /></label>
    <label>Crafting points <input type="number" name="system.craftingPoints" value="{{system.craftingPoints}}" /></label>
    <label>Mod target <input type="text" name="system.targetType" value="{{system.targetType}}" /></label>
    <label>Mod slot <input type="text" name="system.modSlot" value="{{system.modSlot}}" /></label>
    <label>Polarity type <input type="text" name="system.polarityType" value="{{system.polarityType}}" /></label>
    <label>Polarity units <input type="number" name="system.polarityUnits" value="{{system.polarityUnits}}" /></label>
    <label>Quantity <input type="number" name="system.quantity" value="{{system.quantity}}" /></label>
  </div>
{{/if}}

{{#if (eq type "gear")}}
  <div class="lyr-field-grid">
    <label>Quantity <input type="number" name="system.quantity" value="{{system.quantity}}" /></label>
    <label>Burden each <input type="number" name="system.burden" value="{{system.burden}}" /></label>
    <label>Value (Clim) <input type="number" name="system.value" value="{{system.value}}" /></label>
    <label>Material type <input type="text" name="system.materialType" value="{{system.materialType}}" placeholder="Ore, Botany, Wood" /></label>
    <label>Units <input type="number" name="system.units" value="{{system.units}}" /></label>
    <label class="lyr-check"><input type="checkbox" name="system.combatItem" {{checked system.combatItem}} /> Combat item</label>
    <label class="lyr-check"><input type="checkbox" name="system.isKit" {{checked system.isKit}} /> Kit</label>
  </div>
{{/if}}

{{#if (eq type "injury")}}
  <div class="lyr-field-grid">
    <label>Rolled <input type="number" name="system.rolled" value="{{system.rolled}}" min="0" max="10" /></label>
    <label class="lyr-check"><input type="checkbox" name="system.fromDowned" {{checked system.fromDowned}} /> From being downed</label>
    <label class="lyr-check"><input type="checkbox" name="system.suppressed" {{checked system.suppressed}} /> Suppressed</label>
  </div>
  <p class="lyr-note">A single injury is removed by taking the Recover action during an interlude.</p>
{{/if}}

<label>Source <input type="text" name="system.source" value="{{system.source}}" placeholder="Rulebook section or homebrew" /></label>
{{/if}}
</section>
