<section class="tab lyr-tab {{tab.cssClass}}" data-tab="main" data-group="primary" data-application-part="main">

  {{#if system.official.enabled}}
    <div class="lyr-reference-overview lyr-monster-overview">
      <section class="lyr-reference-card">
        <h3>{{localize "LYRIAN.UI.CombatProfile"}}</h3>
        <dl class="lyr-facts">
          {{#if system.official.lightAttack}}<div><dt>{{localize "LYRIAN.Attack.Light"}}</dt><dd>{{system.official.lightAttack}} <button type="button" data-action="monsterAttack" data-attack-type="light" title="{{localize "LYRIAN.Hint.FreeRoll"}}">{{localize "LYRIAN.Action.Roll"}}</button></dd></div>{{/if}}
          {{#if system.official.heavyAttack}}<div><dt>{{localize "LYRIAN.Attack.Heavy"}}</dt><dd>{{system.official.heavyAttack}} <button type="button" data-action="monsterAttack" data-attack-type="heavy" title="{{localize "LYRIAN.Hint.FreeRoll"}}">{{localize "LYRIAN.Action.Roll"}}</button></dd></div>{{/if}}
          {{#if system.official.notableSkills}}<div><dt>{{localize "LYRIAN.UI.NotableSkills"}}</dt><dd>{{system.official.notableSkills}}</dd></div>{{/if}}
          {{#if system.details.recommended}}<div><dt>{{localize "LYRIAN.UI.Recommended"}}</dt><dd>{{system.details.recommended}}</dd></div>{{/if}}
        </dl>
      </section>
      <section class="lyr-reference-card">
        <h3>{{localize "LYRIAN.UI.EncounterNotes"}}</h3>
        <dl class="lyr-facts">
          {{#if system.details.strongAgainst}}<div><dt>{{localize "LYRIAN.UI.StrongAgainst"}}</dt><dd>{{system.details.strongAgainst}}</dd></div>{{/if}}
          {{#if system.details.weakAgainst}}<div><dt>{{localize "LYRIAN.UI.WeakAgainst"}}</dt><dd>{{system.details.weakAgainst}}</dd></div>{{/if}}
          {{#if system.details.appearance}}<div><dt>{{localize "LYRIAN.UI.Appearance"}}</dt><dd>{{system.details.appearance}}</dd></div>{{/if}}
          {{#if system.details.habitat}}<div><dt>{{localize "LYRIAN.UI.Habitat"}}</dt><dd>{{system.details.habitat}}</dd></div>{{/if}}
        </dl>
      </section>
    </div>
  {{/if}}

  <div class="lyr-columns">
    <div class="lyr-col">
      <h2 class="lyr-heading">{{localize "LYRIAN.UI.MainStats"}}</h2>
      <p class="lyr-note">{{localize "LYRIAN.Hint.MainStatArray"}}</p>
      <div class="lyr-stat-grid">
        {{#each mainStats as |stat|}}
          <div class="lyr-stat">
            <button type="button" class="lyr-stat__label" data-action="rollAttribute" data-value="{{stat.total}}" data-label="{{stat.label}}">{{stat.label}}</button>
            <input class="lyr-stat__input" type="number" name="system.stats.{{stat.key}}.value" value="{{stat.value}}" />
            {{#if stat.bonus}}<span class="lyr-stat__bonus">{{lyrianSigned stat.bonus}}</span>{{/if}}
            <span class="lyr-stat__total">{{stat.total}}</span>
          </div>
        {{/each}}
      </div>

      <h2 class="lyr-heading">{{localize "LYRIAN.UI.SubStats"}}</h2>
      <p class="lyr-note">{{localize "LYRIAN.Hint.SubStatArray"}}</p>
      <div class="lyr-stat-grid lyr-stat-grid--sub">
        {{#each subStatList as |stat|}}
          <div class="lyr-stat">
            <button type="button" class="lyr-stat__label" data-action="rollAttribute" data-value="{{stat.total}}" data-label="{{stat.label}}">{{stat.label}}</button>
            <input class="lyr-stat__input" type="number" name="system.subStats.{{stat.key}}.value" value="{{stat.value}}" />
            <span class="lyr-stat__total">{{stat.total}}</span>
          </div>
        {{/each}}
      </div>
    </div>

    <div class="lyr-col">
      <h2 class="lyr-heading">{{localize "LYRIAN.UI.Attacks"}}</h2>
      <ul class="lyr-list">
        {{#unless hasEquippedWeapon}}
          <li class="lyr-row lyr-row--universal">
            <img class="lyr-row__icon" src="{{actor.img}}" alt="" />
            <div class="lyr-row__body">
              <span class="lyr-row__name">{{localize "LYRIAN.Attack.Universal"}}</span>
              <span class="lyr-row__meta">{{localize "LYRIAN.Hint.UniversalAttack"}}</span>
            </div>
            <div class="lyr-row__actions">
              <button type="button" data-action="universalAttack" data-attack-type="light" title="{{localize "LYRIAN.Cost.OneAP"}}">{{localize "LYRIAN.Attack.Light"}}</button>
              <button type="button" data-action="universalAttack" data-attack-type="heavy" title="{{localize "LYRIAN.Cost.TwoAP"}}">{{localize "LYRIAN.Attack.Heavy"}}</button>
              <button type="button" data-action="universalAttack" data-attack-type="precise" title="{{localize "LYRIAN.Cost.TwoAP"}}">{{localize "LYRIAN.Attack.Precise"}}</button>
            </div>
          </li>
        {{/unless}}
        {{#each items.weapons as |weapon|}}
          <li class="lyr-row {{#unless weapon.system.equipped}}lyr-row--stowed{{/unless}}" data-item-id="{{weapon.id}}">
            <img class="lyr-row__icon" src="{{weapon.img}}" alt="" />
            <div class="lyr-row__body">
              <span class="lyr-row__name">{{weapon.name}}</span>
              <span class="lyr-row__meta">
                {{lyrianLocalizeKey "weaponGroups" weapon.system.group}} ·
                {{#if weapon.system.isTwoHanded}}{{localize "LYRIAN.UI.TwoHanded"}}{{else}}{{localize "LYRIAN.UI.OneHanded"}}{{/if}} ·
                {{weapon.system.range}} {{localize "LYRIAN.Unit.Feet"}}
                {{#if (lt weapon.system.effectiveCrit 20)}} · {{localize "LYRIAN.UI.CritOn"}} {{weapon.system.effectiveCrit}}+{{/if}}
              </span>
            </div>
            <div class="lyr-row__actions">
              <button type="button" data-action="attack" data-attack-type="light" title="{{localize "LYRIAN.Cost.OneAP"}}">{{localize "LYRIAN.Attack.Light"}}</button>
              <button type="button" data-action="attack" data-attack-type="heavy" title="{{localize "LYRIAN.Cost.TwoAP"}}">{{localize "LYRIAN.Attack.Heavy"}}</button>
              <button type="button" data-action="attack" data-attack-type="precise" title="{{localize "LYRIAN.Cost.TwoAP"}}">{{localize "LYRIAN.Attack.Precise"}}</button>
              <button type="button" class="lyr-icon" data-action="toggleEquip" title="{{localize "LYRIAN.Action.EquipStow"}}">
                <i class="fa-solid {{#if weapon.system.equipped}}fa-hand-fist{{else}}fa-box{{/if}}"></i>
              </button>
              <button type="button" class="lyr-icon" data-action="editItem" title="{{localize "LYRIAN.Action.Edit"}}"><i class="fa-solid fa-pen"></i></button>
            </div>
          </li>
        {{else}}
          <li class="lyr-empty">{{#if isNPC}}{{localize "LYRIAN.Empty.MonsterWeapons"}}{{else}}{{localize "LYRIAN.Empty.CharacterWeapons"}}{{/if}}</li>
        {{/each}}
      </ul>

      <h2 class="lyr-heading">{{localize "LYRIAN.UI.Injuries"}}</h2>
      <ul class="lyr-list lyr-list--tight">
        {{#each items.injuries as |injury|}}
          <li class="lyr-row" data-item-id="{{injury.id}}">
            <div class="lyr-row__body"><span class="lyr-row__name">{{injury.name}}</span></div>
            <div class="lyr-row__actions">
              <button type="button" class="lyr-icon" data-action="editItem"><i class="fa-solid fa-pen"></i></button>
              <button type="button" class="lyr-icon" data-action="deleteItem"><i class="fa-solid fa-trash"></i></button>
            </div>
          </li>
        {{else}}
          <li class="lyr-empty">{{localize "LYRIAN.Empty.Uninjured"}}</li>
        {{/each}}
      </ul>
      <button type="button" class="lyr-wide" data-action="rollInjury">{{localize "LYRIAN.Action.RollInjury"}}</button>

      {{#if system.overBurdened}}
        <p class="lyr-alert">{{localize "LYRIAN.UI.OverBurdened" burden=system.burden limit=config.burdenLimit}}</p>
      {{else}}
        <p class="lyr-note">{{localize "LYRIAN.UI.BurdenSummary" burden=system.burden limit=config.burdenLimit}}</p>
      {{/if}}
    </div>
  </div>
</section>
