<section class="tab lyr-tab {{tab.cssClass}}" data-tab="abilities" data-group="primary" data-application-part="abilities">

  <div class="lyr-section-head">
    <h2 class="lyr-heading">Abilities</h2>
    <div class="lyr-section-actions">
      <button type="button" data-action="browsePack" data-pack="{{#if isNPC}}monster-abilities{{else}}player-abilities{{/if}}"><i class="fa-solid fa-book-open"></i> Browse compendium</button>
      <button type="button" data-action="createItem" data-type="{{#if isNPC}}monsterAbility{{else}}ability{{/if}}">Add ability</button>
    </div>
  </div>
  <p class="lyr-note">Drag abilities from the compendium onto this sheet. Shift-click Use to skip the resource cost.</p>

  {{#*inline "abilityRow"}}
    <li class="lyr-row {{#if this.system.usedThisRound}}lyr-row--spent{{/if}}" data-item-id="{{this.id}}">
      <img class="lyr-row__icon" src="{{this.img}}" alt="" />
      <div class="lyr-row__body">
        <span class="lyr-row__name">{{this.name}}</span>
        <span class="lyr-row__meta">
          {{this.system.costLabel}}
          {{#if this.system.range}} · {{this.system.range}}{{/if}}
          {{#if this.system.requirement}} · Requires {{this.system.requirement}}{{/if}}
        </span>
      </div>
      <div class="lyr-row__actions">
        <button type="button" data-action="useItem">Use</button>
        <button type="button" class="lyr-icon" data-action="editItem"><i class="fa-solid fa-pen"></i></button>
        <button type="button" class="lyr-icon" data-action="deleteItem"><i class="fa-solid fa-trash"></i></button>
      </div>
    </li>
  {{/inline}}

  {{#*inline "grantRow"}}
    <li class="lyr-feature-row" data-item-id="{{item.id}}">
      {{#if requiredLevel}}<span class="lyr-level-badge">Lv. {{requiredLevel}}</span>{{else}}<span class="lyr-level-badge"><i class="fa-solid fa-star"></i></span>{{/if}}
      <img class="lyr-row__icon" src="{{item.img}}" alt="" />
      <button type="button" class="lyr-feature-name" data-action="{{#if usable}}useItem{{else}}editItem{{/if}}">{{item.name}}</button>
      <em class="lyr-feature-role">{{role}}</em>
      <button type="button" class="lyr-icon" data-action="editItem" title="Open"><i class="fa-solid fa-pen"></i></button>
    </li>
  {{/inline}}

  {{#if isCharacter}}
    <section class="lyr-feature-section">
      <h3 class="lyr-feature-heading">Racial Traits {{#if raceSummary.primary}}<span>{{raceSummary.primary.name}}{{#if raceSummary.ancestry}} · {{raceSummary.ancestry.name}}{{/if}}{{#if raceSummary.variant}} · {{raceSummary.variant.name}}{{/if}}</span>{{/if}}</h3>
      <ul class="lyr-feature-list">
        {{#each racialTraits}}{{> grantRow}}{{else}}<li class="lyr-empty">Choose a race to add its traits automatically.</li>{{/each}}
      </ul>
    </section>

    {{#each classGroups as |group|}}
      <section class="lyr-feature-section">
        <h3 class="lyr-feature-heading">{{group.item.name}} <span>Tier {{group.item.system.tier}} · Lv {{group.level}}</span></h3>
        <ul class="lyr-feature-list">
          {{#each group.features}}{{> grantRow}}{{else}}<li class="lyr-empty">No class features unlocked.</li>{{/each}}
        </ul>
      </section>
    {{/each}}
  {{/if}}

  <h3 class="lyr-subheading">{{#if isCharacter}}Other Actions{{else}}Actions{{/if}}</h3>
  <ul class="lyr-list">
    {{#each items.abilities}}{{> abilityRow}}{{else}}<li class="lyr-empty">No active abilities.</li>{{/each}}
  </ul>

  <h3 class="lyr-subheading">Reactions</h3>
  <ul class="lyr-list">
    {{#each items.reactions}}{{> abilityRow}}{{else}}<li class="lyr-empty">No reactions.</li>{{/each}}
  </ul>

  <h3 class="lyr-subheading">Encounter start</h3>
  <ul class="lyr-list">
    {{#each items.encounterStart}}{{> abilityRow}}{{else}}<li class="lyr-empty">None.</li>{{/each}}
  </ul>

  <h3 class="lyr-subheading">Encounter conclusion</h3>
  <ul class="lyr-list">
    {{#each items.encounterConclusion}}{{> abilityRow}}{{else}}<li class="lyr-empty">None.</li>{{/each}}
  </ul>

  <h3 class="lyr-subheading">Passives</h3>
  <ul class="lyr-list">
    {{#each items.passives}}{{> abilityRow}}{{else}}<li class="lyr-empty">None.</li>{{/each}}
  </ul>
</section>
