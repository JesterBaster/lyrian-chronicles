<section class="tab lyr-tab {{tab.cssClass}}" data-tab="setup" data-group="primary" data-application-part="setup">
  <div class="lyr-reference-overview">
    <section class="lyr-reference-card lyr-reference-card--wide">
      <h3>{{localize "LYRIAN.Setup.Title"}}</h3>
      <p>{{localize "LYRIAN.Setup.Description"}}</p>
      <div class="lyr-alert">
        <span>{{localize "LYRIAN.Setup.Warning"}}</span>
      </div>
      {{#if editable}}
        <button type="button" class="lyr-primary lyr-wide" data-action="openCharacterCreation">
          <i class="fa-solid fa-user-pen"></i>
          {{localize "LYRIAN.Action.OpenCharacterCreation"}}
        </button>
      {{else}}
        <p class="lyr-note">{{localize "LYRIAN.Setup.RequiresOwner"}}</p>
      {{/if}}
    </section>

    <section class="lyr-reference-card lyr-reference-card--wide">
      <h3>{{localize "LYRIAN.Setup.ExportTitle"}}</h3>
      <p>{{localize "LYRIAN.Setup.ExportDescription"}}</p>
      <ol class="lyr-note lyr-export-steps">
        <li>{{localize "LYRIAN.Setup.ExportStepTemplate"}}</li>
        <li>{{localize "LYRIAN.Setup.ExportStepPick"}}</li>
        <li>{{localize "LYRIAN.Setup.ExportStepSave"}}</li>
      </ol>
      <button type="button" class="lyr-primary lyr-wide" data-action="exportCharacterSheet">
        <i class="fa-solid fa-file-export"></i>
        {{localize "LYRIAN.Action.ExportCharacterSheet"}}
      </button>
      <p class="lyr-note">{{localize "LYRIAN.Setup.ExportFormulaNote"}}</p>
    </section>
  </div>
</section>
