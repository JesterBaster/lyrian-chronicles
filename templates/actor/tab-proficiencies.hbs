<section class="tab lyr-tab {{tab.cssClass}}" data-tab="proficiencies" data-group="primary" data-application-part="proficiencies">
  <p class="lyr-note">Race and class choices save automatically. Granted proficiencies cannot be removed here.</p>

  <section class="lyr-prof-summary">
    <h2 class="lyr-heading">Weapon &amp; Armor Proficiencies</h2>
    <div class="lyr-prof-summary__line"><strong>Armor:</strong>
      {{#each proficiency.automatic.armor}}<span class="lyr-prof-chip lyr-prof-chip--armor">{{name}}</span>{{else}}<em>None granted</em>{{/each}}
    </div>
    <div class="lyr-prof-summary__line"><strong>Weapons:</strong>
      {{#each proficiency.automatic.weapons}}<span class="lyr-prof-chip">{{name}}</span>{{else}}<em>None granted</em>{{/each}}
    </div>
    <div class="lyr-prof-sources">
      {{#each proficiency.sources as |source|}}
        <section class="lyr-prof-source">
          <header class="lyr-prof-source__header">
            <strong>{{source.name}}</strong>
            {{#if source.entries}}<span>Granted: {{#each source.entries}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}</span>{{/if}}
          </header>
          {{#if source.choices.length}}
            <div class="lyr-prof-choice-grid">
              {{#each source.choices as |choice|}}
                <section class="lyr-prof-choice {{#if choice.complete}}is-complete{{/if}}">
                  <header>
                    <strong>{{choice.title}}</strong>
                    <span>{{#if choice.complete}}<i class="fa-solid fa-check"></i> Saved{{else}}Choose{{/if}}</span>
                  </header>
                  {{#each choice.slots as |slot|}}
                    <div class="lyr-prof-choice__row" data-proficiency-choice data-choice-id="{{../id}}" data-choice-index="{{slot.index}}">
                  {{#if ../allowCustom}}
                        <input type="text" data-proficiency-choice-value value="{{slot.value}}" placeholder="Enter a language or dialect" aria-label="{{../title}}" />
                  {{else}}
                        <select data-proficiency-choice-value aria-label="{{../title}}">
                          <option value="">— Select —</option>
                      {{#each slot.options as |option|}}
                            <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
                      {{/each}}
                        </select>
                  {{/if}}
                    </div>
                  {{/each}}
                  <details class="lyr-prof-choice__rule">
                    <summary>View rule</summary>
                    <p>{{choice.label}}</p>
                  </details>
                </section>
              {{/each}}
            </div>
          {{/if}}
        </section>
      {{else}}<p class="lyr-empty">No automatic proficiency sources yet.</p>{{/each}}
    </div>
  </section>

  {{#*inline "proficiencyCard"}}
    <section class="lyr-prof-card" data-proficiency-kind="{{kind}}">
      <header><h2><i class="{{icon}}"></i> {{title}}</h2><span>{{entries.length}}</span></header>
      <div class="lyr-prof-list">
        {{#each entries as |entry|}}
          <span class="lyr-prof-entry {{#if entry.granted}}is-granted{{/if}}">
            {{entry.name}}
            {{#if entry.granted}}<em>Granted</em>{{else}}<button type="button" data-action="removeProficiency" data-kind="{{../kind}}" data-name="{{entry.name}}" title="Remove">×</button>{{/if}}
          </span>
        {{else}}<em class="lyr-empty">None.</em>{{/each}}
      </div>
      <div class="lyr-prof-add">
        <input type="text" data-proficiency-input placeholder="{{placeholder}}" />
        <button type="button" data-action="addProficiency" data-kind="{{kind}}">+ Add</button>
      </div>
    </section>
  {{/inline}}

  {{> proficiencyCard kind="weapons" title="Weapon Proficiencies" icon="fa-solid fa-khanda" entries=proficiency.groups.weapons placeholder="e.g. Light Swords, Channeling Weapons…"}}
  {{> proficiencyCard kind="armor" title="Armor Proficiencies" icon="fa-solid fa-shield" entries=proficiency.groups.armor placeholder="e.g. Light Armor, Shields…"}}
  {{> proficiencyCard kind="languages" title="Languages" icon="fa-solid fa-comment" entries=proficiency.groups.languages placeholder="e.g. Sorthen, Sylvan…"}}
</section>
