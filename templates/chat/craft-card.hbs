<div class="lyrian-card lyr-craft-card">
  <header class="lyrian-card__head">
    <div>
      <h3>{{project.name}}</h3>
      <span class="lyrian-card__sub">{{skillLabel}} · {{localize "LYRIAN.UI.DC"}} {{dc}}</span>
    </div>
  </header>

  <div class="lyrian-card__line">
    <strong>{{localize "LYRIAN.Craft.Result"}}</strong>
    {{roll.total}}
    {{#if success}}
      <span class="lyr-ok">{{localize "LYRIAN.Roll.Success"}}</span>
    {{else}}
      <span class="lyr-warn">{{localize "LYRIAN.Roll.Failure"}}</span>
    {{/if}}
  </div>

  {{#if consumed}}
    <div class="lyrian-card__text">
      <strong>{{localize "LYRIAN.Craft.MaterialsSpent"}}</strong>
      {{#if materials.length}}
        <ul>
          {{#each materials as |material|}}
            <li>{{material.name}} ×{{material.quantity}}</li>
          {{/each}}
        </ul>
      {{else}}
        <p>{{localize "LYRIAN.Craft.NoMaterials"}}</p>
      {{/if}}
    </div>
  {{else}}
    <p class="lyrian-card__line">{{localize "LYRIAN.Craft.ConsumptionDisabled"}}</p>
  {{/if}}

  {{#if success}}
    <p class="lyrian-card__line">
      <strong>{{localize "LYRIAN.Craft.Output"}}</strong> {{project.outputName}}
    </p>
  {{/if}}

  <div class="dice-roll">
    <div class="dice-result">
      <div class="dice-formula">{{roll.formula}}</div>
      {{{tooltip}}}
      <h4 class="dice-total">{{roll.total}}</h4>
    </div>
  </div>
</div>
