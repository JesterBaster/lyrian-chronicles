<div class="lyrian-card lyr-craft-card {{#if resolved}}{{#if success}}is-success{{else}}is-failure{{/if}}{{/if}}">
  <header class="lyrian-card__head">
    <img src="{{actor.img}}" alt="" />
    <div>
      <h3>{{#if project.name}}{{project.name}}{{else}}{{localize "LYRIAN.Craft.UnnamedOutput"}}{{/if}}</h3>
      <span class="lyrian-card__sub">
        {{#if resolved}}{{localize "LYRIAN.Craft.CraftEnded"}}{{else}}{{actionLabel}} · {{skillLabel}}{{/if}}
      </span>
    </div>
  </header>

  {{#if roll}}
    <div class="dice-roll">
      <div class="dice-result">
        <div class="dice-formula">{{roll.formula}}</div>
        {{{tooltip}}}
        <h4 class="dice-total">{{roll.total}}</h4>
      </div>
    </div>
  {{/if}}

  {{#unless resolved}}
    <p class="lyrian-card__line">
      {{#if doubled}}
        <strong>{{localize "LYRIAN.Craft.Doubled"}}</strong>
      {{else}}
        <strong>{{localize "LYRIAN.Craft.PointsAdded" points=added}}</strong>
      {{/if}}
    </p>
  {{/unless}}

  <ul class="lyrian-card__stats">
    <li><span>{{localize "LYRIAN.Craft.Points"}}</span> <strong>{{status.points}} / {{status.required}}</strong></li>
    <li><span>{{localize "LYRIAN.Craft.Dice"}}</span> <strong>{{status.diceRemaining}}</strong></li>
    {{#if status.shortfall}}
      <li><span>{{localize "LYRIAN.Craft.Short"}}</span> <strong>{{status.shortfall}}</strong></li>
    {{/if}}
  </ul>

  {{#if materials.length}}
    <p class="lyrian-card__line">
      <strong>{{localize "LYRIAN.UI.Materials"}}</strong>
      {{#each materials as |material|}}{{material.name}} ×{{material.quantity}}{{#unless @last}}, {{/unless}}{{/each}}
      {{#unless consumed}} <em>({{localize "LYRIAN.Craft.NotConsumed"}})</em>{{/unless}}
    </p>
  {{/if}}

  {{#if resolved}}
    <p class="lyrian-card__line">
      {{#if success}}
        <strong>{{localize "LYRIAN.Craft.Succeeded" name=outputName}}</strong>
        {{#if custom}} <em>{{localize "LYRIAN.Craft.CustomMade"}}</em>{{/if}}
      {{else}}
        <strong>{{localize "LYRIAN.Craft.Failed"}}</strong>
      {{/if}}
    </p>
    {{#if mods.length}}
      <p class="lyrian-card__line">
        <strong>{{localize "LYRIAN.UI.Mods"}}</strong>
        {{#each mods as |mod|}}{{mod.name}}{{#unless @last}}, {{/unless}}{{/each}}
      </p>
    {{/if}}
  {{/if}}
</div>
