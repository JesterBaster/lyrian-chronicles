<div class="lyrian-card lyrian-card--attack">
  <header class="lyrian-card__head">
    <img src="{{item.img}}" alt="" />
    <div>
      <h3>{{item.name}}</h3>
      <span class="lyrian-card__sub">{{attackTypeLabel}}{{#if damageTypeLabel}} · {{damageTypeLabel}}{{/if}}</span>
    </div>
    {{#if isCrit}}<span class="lyrian-crit">Critical</span>{{/if}}
  </header>

  <div class="lyrian-card__rolls">
    {{#if attackRoll}}
      <div class="lyrian-roll">
        <span class="lyrian-roll__label">Accuracy</span>
        <span class="lyrian-roll__total">{{attackTotal}}</span>
        <span class="lyrian-roll__formula">{{attackRoll.formula}}</span>
      </div>
    {{else}}
      <div class="lyrian-roll"><span class="lyrian-roll__label">Sure hit</span></div>
    {{/if}}

    {{#if damageRoll}}
      <div class="lyrian-roll lyrian-roll--damage">
        <span class="lyrian-roll__label">Damage{{#if isCrit}} (maximised){{/if}}</span>
        <span class="lyrian-roll__total">{{damageTotal}}</span>
        <span class="lyrian-roll__formula">{{damageRoll.formula}}</span>
      </div>
    {{/if}}
  </div>

  {{#if (or pinpoint halfPierce fullPierce)}}
    <p class="lyrian-card__tags">
      {{#if pinpoint}}<span>Pinpoint {{pinpoint}}</span>{{/if}}
      {{#if halfPierce}}<span>Half pierce</span>{{/if}}
      {{#if fullPierce}}<span>Full pierce</span>{{/if}}
    </p>
  {{/if}}

  {{#if hasTargets}}
    <ul class="lyrian-targets">
      {{#each targets as |t|}}
        <li class="lyrian-target {{#if t.hit}}is-hit{{else}}is-miss{{/if}}">
          <span class="lyrian-target__name">{{t.name}}</span>
          <span class="lyrian-target__result">
            {{#if t.untargetable}}In full cover — cannot be targeted{{else}}{{#if t.hit}}Hits Evasion {{t.evasion}}{{else}}Misses Evasion {{t.evasion}}{{/if}}{{/if}}
          </span>
          {{#if t.coverNotes}}<span class="lyrian-target__cover">{{t.coverNotes}}</span>{{/if}}
          {{#if t.hit}}
            <span class="lyrian-target__buttons">
              <button type="button" data-lyrian-action="applyDamage" data-defence="none" data-target-index="{{@index}}">Take it</button>
              <button type="button" data-lyrian-action="applyDamage" data-defence="dodge" data-target-index="{{@index}}" title="Costs 1 RP · Evasion {{t.dodgeEvasion}}">Dodge (1 RP)</button>
              <button type="button" data-lyrian-action="applyDamage" data-defence="block" data-target-index="{{@index}}" title="Costs 1 RP · Guard {{t.blockGuard}}">Block (1 RP)</button>
            </span>
          {{/if}}
        </li>
      {{/each}}
    </ul>
  {{else}}
    <div class="lyrian-card__buttons">
      <span class="lyrian-card__hint">Select the defending token, then choose their reaction:</span>
      <button type="button" data-lyrian-action="applyDamage" data-defence="none">No reaction</button>
      <button type="button" data-lyrian-action="applyDamage" data-defence="dodge">Dodge (1 RP)</button>
      <button type="button" data-lyrian-action="applyDamage" data-defence="block">Block (1 RP)</button>
    </div>
  {{/if}}
</div>
