<div class="lyrian-card">
  <header class="lyrian-card__head">
    <img src="{{item.img}}" alt="" />
    <div>
      <h3>{{item.name}}</h3>
      {{#if system.costLabel}}<span class="lyrian-card__sub">{{system.costLabel}}</span>{{/if}}
    </div>
  </header>
  {{#if system.range}}<p class="lyrian-card__line"><strong>{{localize "LYRIAN.UI.Range"}}</strong> {{system.range}}</p>{{/if}}
  {{#if enrichedRequirement}}<div class="lyrian-card__line"><strong>{{localize "LYRIAN.UI.Requirement"}}</strong> {{{enrichedRequirement}}}</div>{{/if}}
  <div class="lyrian-card__text">{{{enrichedDescription}}}</div>
</div>
