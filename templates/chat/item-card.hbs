<div class="lyrian-card">
  <header class="lyrian-card__head">
    <img src="{{item.img}}" alt="" />
    <div>
      <h3>{{item.name}}</h3>
      <span class="lyrian-card__sub">{{typeLabel}}</span>
    </div>
  </header>
  {{#if stats.length}}
    <ul class="lyrian-card__stats">
      {{#each stats as |stat|}}
        <li><span>{{stat.label}}</span> <strong>{{stat.value}}</strong></li>
      {{/each}}
    </ul>
  {{/if}}
  {{#if keywords.length}}<p class="lyrian-card__line"><strong>{{localize "LYRIAN.UI.Keywords"}}</strong> {{#each keywords}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}
  {{#if enrichedRequirement}}<div class="lyrian-card__line"><strong>{{localize "LYRIAN.UI.Requirement"}}</strong> {{{enrichedRequirement}}}</div>{{/if}}
  <div class="lyrian-card__text">{{{enrichedDescription}}}</div>
</div>
