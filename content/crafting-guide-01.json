            "sourceHash": "8fa9807d0896182ef8182b28c94d8558cbba8f84bcf59e959d1b07ebde3f6409",
            "rulebookVersion": "Flo's Madness",
            "contentBuild": "0.6.0"
          }
        }
      }
    ],
