  {
    "_id": "9771b02d7bb6d45e",
    "name": "Alchemy Materials",
    "pages": [
      {
        "_id": "18f657cc4d01aa8c",
        "name": "Alchemy Materials",
        "type": "text",
        "title": {
          "show": true,
          "level": 1
        },
        "text": {
          "format": 1,
          "content": "<p>When crafting as an alchemist, you may add additional herbs and alchemy materials into the mix. By adding in an extra amount of alchemy units as well as the exact same herbs as the recipe needs, you get extra dice.</p><hr><p><small>Source: <a href=\"https://docs.google.com/spreadsheets/d/1S7ygwpW8p6rqOjf7bfmfylhzx9R3uFfP3ZYBFGlDeLs/edit#gid=1149578449\">Flo's Madness</a>. Prices ending in c are Clim; amounts ending in u are units.</small></p>"
        },
        "flags": {
          "lyrian-chronicles": {
            "seedKey": "flos-madness:crafting-guide--alchemy-materials",
