[
  {
    "_id": "cf4202ff81718a5e",
    "name": "Armorsmithing Materials",
    "pages": [
      {
        "_id": "ae0cff1f140c264b",
        "name": "Armorsmithing Materials",
        "type": "text",
        "title": {
          "show": true,
          "level": 1
        },
        "text": {
          "format": 1,
          "content": "<p>Armor: Each stat bonus gives a +1 evasion and dodge Material bonus or a +1 guard and +2 block Material bonus. A mithril or primehide armor would thus give +1 evasion, dodge and guard as well as +2 Block.</p><p>Shield: Each stat bonus gives a +1 Gear bonus to Dodge or a +3 Gear bonus to Block. </p><p>Cloak: A cloak made with no special material may gain a Gear bonus to its Dodge or Block.<br>When made with Direhide/Primehide/Dragonscale/Astrahide gives a +1/+2/+3/+4 Gear bonus to Dodge or a +2/+4/+6/+8 Gear bonus to Block.</p><p>Same stat bonuses from Shields or Cloak do not stack, ie; a +2 Dodge Cloak and a +2 Dodge Shield would not stack.</p><hr><p><small>Source: <a href=\"https://docs.google.com/spreadsheets/d/1S7ygwpW8p6rqOjf7bfmfylhzx9R3uFfP3ZYBFGlDeLs/edit#gid=888978637\">Flo's Madness</a>. Prices ending in c are Clim; amounts ending in u are units.</small></p>"
        },
        "flags": {
          "lyrian-chronicles": {
            "seedKey": "flos-madness:crafting-guide--armorsmithing-materials",
            "stableId": "crafting-guide--armorsmithing-materials",
            "sourceUrl": "https://docs.google.com/spreadsheets/d/1S7ygwpW8p6rqOjf7bfmfylhzx9R3uFfP3ZYBFGlDeLs/edit#gid=888978637",
            "sourceHash": "e1d4329be00ffa2cb0f285319edcc95dfef3772b8771f56a25e11542cb3ed5dd",
            "rulebookVersion": "Flo's Madness",
            "contentBuild": "0.6.0"
          }
        }
      }
    ],
